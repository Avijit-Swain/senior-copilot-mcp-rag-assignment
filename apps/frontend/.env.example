# Frontend configuration. Copy to .env.local for local development.
# Only VITE_-prefixed variables are exposed to the browser bundle —
# never put a secret in this file.

# Copilot backend the GUI talks to.
VITE_API_BASE_URL=http://localhost:8100

# Shown in the header so a demo recording makes the target obvious.
VITE_ENVIRONMENT_LABEL=local

# Dev server port (read by vite.config.ts).
PORT=5173
