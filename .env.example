# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- LLM and embeddings ---------------------------------------------------
OPENAI_API_KEY=replace-me
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval ------------------------------------------------------------
# Distinct documents returned per query (vectors are deduplicated to documents
# first, since several representations resolve to the same document).
RETRIEVAL_TOP_K=3
# Vectors pulled before deduplication.
RETRIEVAL_OVERFETCH=20
VECTOR_INDEX_PATH=./rag/index
DOCUMENT_PATH=./rag/documents

# --- Alarm Management API (not built yet) ---------------------------------
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=replace-me

# --- MCP (not built yet) --------------------------------------------------
MCP_SERVER_URL=http://alarm-mcp:9000/mcp
MCP_TOOL_TIMEOUT_MS=15000
