# Copy to .env and fill in. .env is git-ignored and must never be committed.

# --- LLM and embeddings ---------------------------------------------------
OPENAI_API_KEY=replace-me
LLM_PROVIDER=openai
# Supervisor reasons about decomposition; tool node reads documents.
SUPERVISOR_MODEL=gpt-4.1
TOOL_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# --- Retrieval ------------------------------------------------------------
# Distinct documents returned per query (vectors are deduplicated to documents
# first, since several representations resolve to the same document).
RETRIEVAL_TOP_K=3
# Vectors pulled before deduplication.
RETRIEVAL_OVERFETCH=20
VECTOR_INDEX_PATH=./rag/index
DOCUMENT_PATH=./rag/documents

# --- Alarm Management API simulator ---------------------------------------
ALARM_API_BASE_URL=http://alarm-api:8000
ALARM_API_TOKEN=replace-me
ALARM_DB_PATH=./test-data/alarm_management.sqlite3

# --- MCP ------------------------------------------------------------------
MCP_SERVER_URL=http://alarm-mcp:9000/mcp
MCP_TOOL_TIMEOUT_MS=15000

# --- Agent loop -----------------------------------------------------------
# Retrieval rounds after the first before the supervisor is forced to answer.
AGENT_MAX_RETRIES=1

# --- Copilot backend -----------------------------------------------------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8080
CORS_ORIGIN=*
MASTER_MODEL=gpt-5.6-terra
STRUCTURED_AGENT_MODEL=gpt-4.1
MASTER_MAX_ROUNDS=3
MASTER_MAX_PARALLEL_TASKS=4
